# Generate a unique random secret before deployment.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
# Optional: use a trusted/self-hosted LibreTranslate instance for generated medical explanations.
# Only generic explanatory copy is sent; uploaded text, OCR, values, units and identifiers are excluded.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Optional SMTP settings for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=0
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Set COOKIE_SECURE=1 only when serving over HTTPS.
COOKIE_SECURE=0
